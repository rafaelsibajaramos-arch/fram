NODE_ENV=development
PORT=3002
SERVICE_NAME=catalog-service

# Neon PostgreSQL - catalog_db (base SEPARADA de producer_db)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/catalog_db?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/catalog_db?sslmode=require"

RABBITMQ_URL=amqp://farmtotable:farmtotable@localhost:5672
RABBITMQ_EXCHANGE=farmtotable.events

# REST hacia Productores (validar producer_id / farm_id)
PRODUCER_SERVICE_URL=http://localhost:3001
PRODUCER_SERVICE_TIMEOUT_MS=3000

# Redis: solo cache de lectura, nunca fuente de stock
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=30

JWT_ALG=HS256
JWT_SECRET=dev-only-change-me
JWT_PUBLIC_KEY=
INTERNAL_API_KEY=dev-internal-key
AUTH_DISABLED=false

OUTBOX_POLL_MS=3000
OUTBOX_BATCH_SIZE=50

# Precio dinamico (configurable, seccion 55)
LOW_STOCK_FACTOR=1.10
HIGH_STOCK_FACTOR=0.90
