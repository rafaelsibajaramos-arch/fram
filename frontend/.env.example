# El gateway también lee el .env de la raíz del proyecto.
# Use este archivo solo para sobrescribir algo en desarrollo.
GATEWAY_PORT=4000
PRODUCER_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
IDENTITY_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
RABBITMQ_MGMT_URL=http://localhost:15672
# Peticiones por minuto y por IP contra /api
RATE_LIMIT=300
UPSTREAM_TIMEOUT_MS=10000
