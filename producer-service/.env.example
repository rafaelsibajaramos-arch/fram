NODE_ENV=development
PORT=3001
SERVICE_NAME=producer-service

# Neon PostgreSQL - producer_db
# Pooled (runtime). Neon exige sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/producer_db?sslmode=require"
# Unpooled (migraciones de Prisma)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/producer_db?sslmode=require"

RABBITMQ_URL=amqp://farmtotable:farmtotable@localhost:5672
RABBITMQ_EXCHANGE=farmtotable.events

# JWT: RS256 con clave publica en produccion; HS256 con secreto para desarrollo local
JWT_ALG=HS256
JWT_SECRET=dev-only-change-me
JWT_PUBLIC_KEY=

# Token compartido para /internal/* (autenticacion de servicio)
INTERNAL_API_KEY=dev-internal-key

# true SOLO en desarrollo: desactiva el guard de JWT
AUTH_DISABLED=false

OUTBOX_POLL_MS=3000
OUTBOX_BATCH_SIZE=50
