# Identidad: copie a .env solo para desarrollo local. No suba credenciales reales.
NODE_ENV=development
PORT=3003

# Base PostgreSQL propia del servicio (Neon). DATABASE_URL puede ser pooled;
# DIRECT_URL debe ser la conexión directa para ejecutar migraciones Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/identity_db?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/identity_db?sslmode=require

# Identity firma tokens RS256. Use PEM escapado con \n o el PEM codificado en base64.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=farmtotable-identity
JWT_AUDIENCE=farmtotable-api

# RabbitMQ: necesario para publicar eventos de identidad.
RABBITMQ_URL=amqp://USER:PASSWORD@localhost:5672
RABBITMQ_EXCHANGE=farmtotable.events

# Gmail u otro SMTP: sin estos datos se deshabilita el envío real de correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM=FarmToTable <tu-cuenta@gmail.com>
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000
APP_PUBLIC_URL=http://localhost:4000

# Solo para desarrollo/pruebas: nunca exponer tokens de acción en producción.
AUTH_EXPOSE_ACTION_TOKENS=false
