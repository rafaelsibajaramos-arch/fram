{
  "name": "farmtotable-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend start",
    "install:all": "npm install --prefix frontend && npm install --prefix producer-service && npm install --prefix catalog-service && npm install --prefix identity-service && npm install --prefix inventory-service && npm install --prefix order-service && npm install --prefix payment-service && npm install --prefix logistics-service && npm install --prefix notification-service && npm install --prefix analytics-service && npm install --prefix driver-mobile",
    "build:producer": "npm --prefix producer-service run build",
    "build:catalog": "npm --prefix catalog-service run build",
    "build:identity": "npm --prefix identity-service run build",
    "build:inventory": "npm --prefix inventory-service run build",
    "build:order": "npm --prefix order-service run build",
    "build:payment": "npm --prefix payment-service run build",
    "build:logistics": "npm --prefix logistics-service run build",
    "test:e2e:checkout": "node scripts/checkout-saga-e2e.mjs",
    "test:e2e:analytics-rebuild": "node scripts/analytics-rebuild-e2e.mjs",
    "test:e2e:notifications": "node scripts/notifications-e2e.mjs",
    "test:e2e:rating-analytics": "node scripts/order-rating-analytics-e2e.mjs",
    "test:e2e:identity-gateway": "node scripts/identity-gateway-e2e.mjs",
    "test:e2e:local-stack": "node scripts/local-stack-smoke.mjs",
    "test:e2e:full-marketplace-local": "node scripts/full-marketplace-local-e2e.mjs",
    "test:staging:guards": "node --test scripts/staging-health-smoke.test.mjs",
    "ops:dlq:redrive": "node scripts/rabbitmq-dlq-redrive.mjs",
    "test:producer": "npm --prefix producer-service test -- --runInBand",
    "test:catalog": "npm --prefix catalog-service test -- --runInBand",
    "test:driver-mobile": "npm --prefix driver-mobile test",
    "typecheck:driver-mobile": "npm --prefix driver-mobile run typecheck",
    "build:driver-mobile": "npm --prefix driver-mobile run build:android"
