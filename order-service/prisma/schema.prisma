generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  dispatched
  delivered
  partial
}

enum PaymentStatus {
  pending
  authorized
  captured
  voided
  failed
  refunded
}

enum OutboxStatus {
  pending
  published
  failed
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  buyerId         String        @db.Uuid
  simulatedCardId String?       @map("simulated_card_id") @db.Uuid
  status          OrderStatus   @default(pending)
  totalAmount     Decimal       @db.Decimal(12, 2)
  currency        String        @default("COP") @db.VarChar(3)
  deliveryAddress String        @db.VarChar(500)
  paymentStatus   PaymentStatus @default(pending)
  checkoutInventoryStatus String @default("pending") @db.VarChar(24)
  paymentId       String?       @db.Uuid
  inventoryConsumed Boolean    @default(false)
  settledAmount   Decimal       @default(0) @db.Decimal(12, 2)
  idempotencyKey  String?       @unique @db.VarChar(180)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  rating          OrderRating?

  @@index([buyerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal  @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  acceptedQuantity Decimal? @db.Decimal(12, 3)
  acceptedSubtotal Decimal? @db.Decimal(12, 2)
  priceVersionId   String?  @db.Uuid
  producerId       String?  @db.Uuid
  productName      String?  @db.VarChar(180)
  producerName     String?  @db.VarChar(180)
  reservationId    String?  @db.Uuid
  harvestBatchId   String?  @db.Uuid
  farmId           String?  @db.Uuid
  pickupAddress    String?  @db.Text
  pickupLatitude   Decimal? @db.Decimal(9, 6)
  pickupLongitude  Decimal? @db.Decimal(9, 6)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([producerId])
  @@map("order_items")
}

model OrderRating {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @db.Uuid
  buyerId   String   @db.Uuid
  score     Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt])
  @@map("order_ratings")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  buyerId   String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal? @db.Decimal(12, 2)
  priceVersionId String?  @db.Uuid
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @db.VarChar(120)
  aggregateId   String       @db.Uuid
  routingKey    String?      @db.VarChar(160)
  sourceService String       @default("order-service") @db.VarChar(80)
  entityVersion Int          @default(1)
  schemaVersion Int          @default(1)
  correlationId String       @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(180)
  occurredAt    DateTime     @default(now())
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, availableAt])
  @@map("order_outbox_events")
}

model ProcessedEvent {
  eventId       String   @id @db.Uuid
  eventType     String   @db.VarChar(120)
  sourceService String   @db.VarChar(80)
  entityId      String   @db.Uuid
  processedAt   DateTime @default(now())

  @@map("order_processed_events")
}
