NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://USER:PASSWORD@HOST/logistics_db?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/logistics_db?sslmode=require
JWT_PUBLIC_KEY=
JWT_ISSUER=farmtotable-identity
JWT_AUDIENCE=farmtotable-api
INTERNAL_API_KEY=cambie-esta-clave-compartida
PAYMENT_SERVICE_URL=http://payment-service:3006
PRODUCER_SERVICE_URL=http://producer-service:3001
RABBITMQ_URL=amqp://farmtotable:farmtotable@localhost:5672
RABBITMQ_EXCHANGE=farmtotable.events
OUTBOX_POLL_MS=3000
OUTBOX_BATCH_SIZE=50
COLD_CHAIN_MAX_C=8
DELIVERY_WINDOW_START_DAYS=1
DELIVERY_WINDOW_END_DAYS=7
# Motor propio o contratado. Ejemplo local: http://127.0.0.1:5500
OSRM_URL=
# Solo para migrar clientes antiguos; la interfaz nueva usa propuestas calculadas.
ALLOW_LEGACY_ROUTE_CREATION=false
