DIRECT_URL="postgresql://user:password@host/payment_db?sslmode=require"
JWT_PUBLIC_KEY=base64_encoded_identity_public_key
JWT_ISSUER=farmtotable-identity
JWT_AUDIENCE=farmtotable-api
