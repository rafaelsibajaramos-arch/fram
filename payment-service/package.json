{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint src --config ../scripts/eslint.config.mjs --max-warnings=0",
    "test": "npm run build && node --test test/outbox.worker.test.cjs test/payments.service.test.cjs",
    "test:integration": "npm run build && node --test test/events.service.integration.test.cjs test/outbox.integration.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.5.0",
    "amqp-connection-manager": "^4.1.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "^6.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.14",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
