# Inventario: copie a .env solo para desarrollo local. No suba credenciales reales.
NODE_ENV=development
PORT=3004

# Base PostgreSQL propia del servicio (Neon). DIRECT_URL es para migraciones.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/inventory_db?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/inventory_db?sslmode=require

# Clave pública PEM de Identity: nunca configurar la clave privada aquí.
JWT_PUBLIC_KEY=
JWT_ISSUER=farmtotable-identity
JWT_AUDIENCE=farmtotable-api

# RabbitMQ para eventos de catálogo e inventario.
RABBITMQ_URL=amqp://USER:PASSWORD@localhost:5672
RABBITMQ_EXCHANGE=farmtotable.events
