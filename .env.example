# Variables de docker-compose. Copie este archivo a .env y complete los valores.
# NUNCA suba el archivo .env a Git.

# ---------------------------------------------------------------- Neon
# Una base de datos por microservicio. Tome las cadenas del panel de Neon.
# *_DATABASE_URL: conexion pooled (uso normal de la aplicacion)
# *_DIRECT_URL:   conexion unpooled (migraciones de Prisma)
PRODUCER_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/producer_db?sslmode=require"
PRODUCER_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/producer_db?sslmode=require"

CATALOG_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/catalog_db?sslmode=require"
CATALOG_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/catalog_db?sslmode=require"

# ------------------------------------------------------------ RabbitMQ
RABBITMQ_USER=farmtotable
RABBITMQ_PASS=cambie-esta-clave
RABBITMQ_EXCHANGE=farmtotable.events

# ----------------------------------------------------------------- JWT
# Los tokens los emite el microservicio de Identidad; aqui solo se verifican.
# En produccion: JWT_ALG=RS256 y JWT_PUBLIC_KEY con la clave publica.
JWT_ALG=HS256
JWT_SECRET=cambie-este-secreto
JWT_PUBLIC_KEY=

# Clave compartida para las rutas /internal/* (Catalogo -> Productores)
INTERNAL_API_KEY=cambie-esta-clave-interna

# ------------------------------------------------------------- Catalogo
CACHE_TTL_SECONDS=30
LOW_STOCK_FACTOR=1.10
HIGH_STOCK_FACTOR=0.90

# CORS: origenes exactos separados por coma. Vacio = sin CORS.
CORS_ORIGINS=
